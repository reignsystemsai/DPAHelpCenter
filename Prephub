<div id="prephub-desktop-results">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">

<style>
#prephub-desktop-results{
  width:100%;
  max-width:1180px;
  margin:0 auto;
  padding:24px 28px 38px;
  background:#fff;
  font-family:Inter,Arial,sans-serif;
  color:#081F5C;
  overflow-x:hidden!important;
  -ms-overflow-style:none!important;
  scrollbar-width:none!important;
}
#prephub-desktop-results,
#prephub-desktop-results *{
  box-sizing:border-box;
  font-family:Inter,Arial,sans-serif;
}
#prephub-desktop-results::-webkit-scrollbar,
#prephub-desktop-results *::-webkit-scrollbar{
  width:0!important;
  height:0!important;
  display:none!important;
}

/* HEADER */
#prephub-desktop-results .ph-top{
  display:grid;
  grid-template-columns:320px 1fr 270px;
  gap:24px;
  align-items:start;
  margin-bottom:30px;
}
#prephub-desktop-results .ph-logo-wrap{
  text-align:left;
}
#prephub-desktop-results .ph-logo{
  font-size:34px;
  line-height:.95;
  font-weight:950;
  letter-spacing:-1px;
  color:#081F5C;
  white-space:nowrap;
}
#prephub-desktop-results .ph-logo:after{
  content:"";
  display:block;
  width:145px;
  height:7px;
  background:#D22630;
  border-radius:999px;
  margin:6px 0 12px 54px;
}
#prephub-desktop-results .ph-kicker{
  font-size:11px;
  font-weight:900;
  letter-spacing:5px;
  color:#0057B8;
  text-transform:uppercase;
  white-space:nowrap;
}

/* HERO */
#prephub-desktop-results .ph-hero{
  text-align:center;
  margin:0 auto;
}
#prephub-desktop-results .ph-small-kicker{
  font-size:11px;
  font-weight:950;
  letter-spacing:5px;
  color:#0057B8;
  text-transform:uppercase;
  margin-bottom:8px;
}
#prephub-desktop-results .ph-hero h1{
  font-size:46px;
  line-height:.96;
  letter-spacing:-2.6px;
  font-weight:950;
  margin:0 0 12px;
  color:#081F5C;
}
#prephub-desktop-results .ph-hero h1 span{
  color:#D22630;
}
#prephub-desktop-results .ph-hero p{
  font-size:15px;
  font-weight:700;
  line-height:1.45;
  color:#5f6b7f;
  margin:0 auto;
  max-width:620px;
}

/* TRUST BAR */
#prephub-desktop-results .dpa-right-trust{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  margin:0 auto;
  width:100%;
  max-width:270px;
  padding:13px 14px;
  border:1px solid rgba(8,31,92,.08);
  border-radius:18px;
  background:#fff;
  box-shadow:0 14px 34px rgba(8,31,92,.07);
  overflow:hidden;
}
#prephub-desktop-results .dpa-face-stack{
  width:148px;
  height:38px;
  position:relative;
  flex:0 0 148px;
}
#prephub-desktop-results .dpa-face{
  width:38px;
  height:38px;
  border-radius:50%;
  position:absolute;
  top:0;
  border:2.5px solid #fff;
  overflow:hidden;
  opacity:0;
  transform:scale(.86);
  animation:prephubDesktopFaceCycle 20s infinite;
  background:#eef3ff;
  box-shadow:0 8px 14px rgba(8,31,92,.08);
}
#prephub-desktop-results .dpa-face img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}
#prephub-desktop-results .dpa-face:nth-child(1),
#prephub-desktop-results .dpa-face:nth-child(6),
#prephub-desktop-results .dpa-face:nth-child(11),
#prephub-desktop-results .dpa-face:nth-child(16){left:0}
#prephub-desktop-results .dpa-face:nth-child(2),
#prephub-desktop-results .dpa-face:nth-child(7),
#prephub-desktop-results .dpa-face:nth-child(12),
#prephub-desktop-results .dpa-face:nth-child(17){left:28px}
#prephub-desktop-results .dpa-face:nth-child(3),
#prephub-desktop-results .dpa-face:nth-child(8),
#prephub-desktop-results .dpa-face:nth-child(13),
#prephub-desktop-results .dpa-face:nth-child(18){left:56px}
#prephub-desktop-results .dpa-face:nth-child(4),
#prephub-desktop-results .dpa-face:nth-child(9),
#prephub-desktop-results .dpa-face:nth-child(14),
#prephub-desktop-results .dpa-face:nth-child(19){left:84px}
#prephub-desktop-results .dpa-face:nth-child(5),
#prephub-desktop-results .dpa-face:nth-child(10),
#prephub-desktop-results .dpa-face:nth-child(15),
#prephub-desktop-results .dpa-face:nth-child(20){left:112px}
#prephub-desktop-results .dpa-face:nth-child(1),
#prephub-desktop-results .dpa-face:nth-child(2),
#prephub-desktop-results .dpa-face:nth-child(3),
#prephub-desktop-results .dpa-face:nth-child(4),
#prephub-desktop-results .dpa-face:nth-child(5){animation-delay:0s}
#prephub-desktop-results .dpa-face:nth-child(6),
#prephub-desktop-results .dpa-face:nth-child(7),
#prephub-desktop-results .dpa-face:nth-child(8),
#prephub-desktop-results .dpa-face:nth-child(9),
#prephub-desktop-results .dpa-face:nth-child(10){animation-delay:5s}
#prephub-desktop-results .dpa-face:nth-child(11),
#prephub-desktop-results .dpa-face:nth-child(12),
#prephub-desktop-results .dpa-face:nth-child(13),
#prephub-desktop-results .dpa-face:nth-child(14),
#prephub-desktop-results .dpa-face:nth-child(15){animation-delay:10s}
#prephub-desktop-results .dpa-face:nth-child(16),
#prephub-desktop-results .dpa-face:nth-child(17),
#prephub-desktop-results .dpa-face:nth-child(18),
#prephub-desktop-results .dpa-face:nth-child(19),
#prephub-desktop-results .dpa-face:nth-child(20){animation-delay:15s}

@keyframes prephubDesktopFaceCycle{
  0%,21%{opacity:1;transform:scale(1)}
  25%,100%{opacity:0;transform:scale(.86)}
}

#prephub-desktop-results .dpa-trust-copy{
  font-size:13px;
  font-weight:750;
  line-height:1.1;
  color:#6f7890;
  text-align:left;
  min-width:0;
}
#prephub-desktop-results .dpa-trust-copy strong{
  color:#081F5C;
  font-weight:950;
}
#prephub-desktop-results .dpa-stars{
  margin-top:5px;
  color:#F5B301;
  font-size:15px;
  letter-spacing:2px;
}
#prephub-desktop-results .ph-dots{
  display:none;
}

/* MAIN LAYOUT */
#prephub-desktop-results .ph-shell{
  display:grid;
  grid-template-columns:1.08fr .92fr;
  gap:22px;
  align-items:start;
}
#prephub-desktop-results .ph-left,
#prephub-desktop-results .ph-right{
  min-width:0;
}

/* STEPS */
#prephub-desktop-results .ph-steps{
  width:100%;
  margin:0;
  padding:22px;
  border:1px solid rgba(8,31,92,.08);
  border-radius:24px;
  background:rgba(255,255,255,.66);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  box-shadow:none!important;
  overflow:hidden!important;
}
#prephub-desktop-results .ph-section-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  margin:0 0 16px;
}
#prephub-desktop-results .ph-section-title{
  display:flex;
  align-items:center;
  gap:12px;
  font-size:25px;
  line-height:1.05;
  font-weight:950;
  letter-spacing:-1px;
  margin:0;
  color:#081F5C;
  min-width:0;
}
#prephub-desktop-results .ph-target{
  width:38px;
  height:38px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:rgba(210,38,48,.08);
  color:#D22630;
  font-size:22px;
  flex:0 0 auto;
}
#prephub-desktop-results .ph-focus{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:#D22630;
  color:#fff;
  font-size:12px;
  font-weight:900;
  border-radius:8px;
  padding:9px 14px;
  white-space:nowrap;
  flex:0 0 auto;
}
#prephub-desktop-results .ph-cards{
  display:grid;
  gap:13px;
}
#prephub-desktop-results .ph-card{
  position:relative;
  width:100%;
  min-height:105px;
  border-radius:18px;
  border:1px solid rgba(8,31,92,.08);
  background:rgba(255,255,255,.70);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  padding:18px 82px 18px 18px;
  display:grid;
  grid-template-columns:74px minmax(0,1fr);
  gap:16px;
  align-items:center;
  text-decoration:none;
  overflow:hidden;
  box-shadow:none!important;
  transition:transform .22s ease, border-color .22s ease, background .22s ease;
}
#prephub-desktop-results .ph-card:hover{
  transform:translateY(-3px);
  border-color:rgba(210,38,48,.24);
  background:rgba(255,255,255,.86);
}
#prephub-desktop-results .ph-icon{
  width:64px;
  height:64px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:rgba(210,38,48,.08);
  color:#D22630;
  font-size:31px;
}
#prephub-desktop-results .ph-tag{
  display:block;
  color:#D22630;
  font-size:9px;
  font-weight:950;
  letter-spacing:1.4px;
  text-transform:uppercase;
  margin-bottom:5px;
}
#prephub-desktop-results .ph-card h3{
  font-size:20px;
  line-height:1.05;
  font-weight:950;
  letter-spacing:-.5px;
  margin:0 0 6px;
  color:#081F5C;
}
#prephub-desktop-results .ph-card p{
  font-size:13px;
  font-weight:650;
  line-height:1.35;
  color:#1b2b55;
  margin:0;
}
#prephub-desktop-results .ph-check{
  position:absolute;
  right:44px;
  top:50%;
  transform:translateY(-50%);
  width:31px;
  height:31px;
  border-radius:50%;
  background:#D22630;
  color:#fff;
  display:grid;
  place-items:center;
  font-size:13px;
  font-weight:950;
  box-shadow:none!important;
}
#prephub-desktop-results .ph-arrow{
  position:absolute;
  right:18px;
  top:50%;
  transform:translateY(-50%);
  color:#081F5C;
  font-size:30px;
  line-height:1;
  font-weight:400;
}

/* ALERT */
#prephub-desktop-results .ph-alert{
  display:grid;
  grid-template-columns:54px minmax(0,1fr);
  gap:14px;
  align-items:center;
  width:100%;
  border:1px solid rgba(210,38,48,.16);
  background:rgba(210,38,48,.045);
  border-radius:17px;
  padding:16px 18px;
  margin:14px 0 0;
  box-shadow:none!important;
}
#prephub-desktop-results .ph-alert-icon{
  width:54px;
  height:54px;
  border-radius:50%;
  background:#D22630;
  color:#fff;
  display:grid;
  place-items:center;
  font-size:28px;
  font-weight:950;
}
#prephub-desktop-results .ph-alert strong{
  display:block;
  font-size:17px;
  color:#D22630;
  line-height:1.2;
}
#prephub-desktop-results .ph-alert span{
  display:block;
  font-size:13px;
  font-weight:650;
  color:#081F5C;
  line-height:1.35;
}

/* PREPHUB SAVE BOX */
#prephub-desktop-results .ph-prep-blue{
  width:100%;
  margin:0 auto 16px;
  border-radius:24px;
  background:linear-gradient(135deg,#081F5C,#001B4F);
  color:#fff;
  padding:28px 28px 24px;
  box-shadow:none!important;
  overflow:hidden;
}
#prephub-desktop-results .ph-prep-blue small{
  display:block;
  font-size:10px;
  font-weight:900;
  letter-spacing:3px;
  text-transform:uppercase;
  color:rgba(255,255,255,.78);
  margin:0 0 11px;
}
#prephub-desktop-results .ph-prep-blue h2{
  margin:0 0 10px;
  font-size:38px;
  line-height:.9;
  letter-spacing:-1.6px;
  font-weight:950;
  color:#fff;
}
#prephub-desktop-results .ph-prep-blue h2 span{
  color:#D22630;
}
#prephub-desktop-results .ph-prep-blue p{
  margin:0 0 20px;
  font-size:13px;
  font-weight:750;
  line-height:1.4;
  color:rgba(255,255,255,.9);
}
#prephub-desktop-results .ph-prep-blue .ph-copy-label{
  font-size:12px;
  font-weight:700;
  color:rgba(255,255,255,.88);
  margin:0 0 8px;
}
#prephub-desktop-results .ph-copy{
  width:100%;
  min-width:0;
  display:grid;
  grid-template-columns:42px minmax(0,1fr) 110px;
  height:46px;
  border-radius:13px;
  overflow:hidden;
  background:rgba(255,255,255,.95);
  border:1px solid rgba(255,255,255,.12);
  box-shadow:none!important;
}
#prephub-desktop-results .ph-link-icon{
  display:grid;
  place-items:center;
  color:#081F5C;
  font-size:18px;
  background:#fff;
}
#prephub-desktop-results .ph-url{
  display:flex;
  align-items:center;
  padding:0 12px;
  font-size:12px;
  font-weight:800;
  color:#081F5C;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
  min-width:0;
}
#prephub-desktop-results .ph-copy button{
  border:0;
  background:#D22630;
  color:#fff;
  font-size:11px;
  font-weight:950;
  cursor:pointer;
  transition:transform .22s ease, background .22s ease;
}
#prephub-desktop-results .ph-copy button:hover{
  background:#b91d27;
  transform:translateY(-1px);
}
#prephub-desktop-results #copyStatusDesktop{
  font-size:10px;
  font-weight:800;
  margin:9px 0 0;
  color:rgba(255,255,255,.72);
}
#prephub-desktop-results .ph-benefits{
  display:grid;
  gap:12px;
  margin-top:18px;
  padding-top:16px;
  border-top:1px solid rgba(255,255,255,.12);
}
#prephub-desktop-results .ph-benefit{
  display:grid;
  grid-template-columns:34px 1fr;
  gap:12px;
  align-items:center;
  color:#fff;
  font-size:13px;
  font-weight:750;
  line-height:1.25;
}
#prephub-desktop-results .ph-benefit i{
  width:34px;
  height:34px;
  border-radius:50%;
  display:grid;
  place-items:center;
  font-style:normal;
  background:rgba(255,255,255,.08);
  color:#fff;
  font-weight:950;
  font-size:14px;
}

/* EMAIL */
#prephub-desktop-results .ph-email{
  width:100%;
  margin:0 auto;
  border:1px solid rgba(0,87,184,.12);
  border-radius:20px;
  background:rgba(255,255,255,.66);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
  padding:22px;
  display:grid;
  grid-template-columns:60px minmax(0,1fr);
  gap:14px;
  align-items:center;
  box-shadow:none!important;
}
#prephub-desktop-results .ph-email-icon{
  width:54px;
  height:54px;
  border-radius:16px;
  display:grid;
  place-items:center;
  color:#081F5C;
  font-size:32px;
}
#prephub-desktop-results .ph-email h3{
  font-size:21px;
  margin:0 0 6px;
  font-weight:950;
}
#prephub-desktop-results .ph-email p{
  font-size:13px;
  font-weight:700;
  color:#5f6b7f;
  margin:0;
  line-height:1.4;
}

