<script>
(function(){
  const PREPHUB_DESKTOP_LINK="https://www.dpahelpcenter.com/prephub";
  const HOMEBUYER_DESKTOP_FACE_IDS=[
    12,15,33,36,47,
    52,55,57,60,61,
    63,68,70,75,78,
    82,84,88,91,94
  ];

  function prephubDesktopFaces(){
    let h="";
    for(let i=0;i<HOMEBUYER_DESKTOP_FACE_IDS.length;i++){
      h+='<span class="dpa-face"><img src="https://randomuser.me/api/portraits/'+(i%2===0?'women':'men')+'/'+HOMEBUYER_DESKTOP_FACE_IDS[i]+'.jpg" alt="Homebuyer"></span>';
    }
    return h;
  }

  const stack=document.getElementById("dpaFaceStackDesktop");
  if(stack)stack.innerHTML=prephubDesktopFaces();

  const urlEl=document.getElementById("prephubUrlDesktop");
  if(urlEl)urlEl.textContent=PREPHUB_DESKTOP_LINK;

  window.copyPrephubDesktopLink=function(){
    const s=document.querySelector("#prephub-desktop-results #copyStatusDesktop");

    if(navigator.clipboard&&window.isSecureContext){
      navigator.clipboard.writeText(PREPHUB_DESKTOP_LINK).then(function(){
        if(s)s.textContent="Link copied to your clipboard.";
      }).catch(function(){
        fallbackCopyPrephubDesktopLink();
      });
    }else{
      fallbackCopyPrephubDesktopLink();
    }
  };

  function fallbackCopyPrephubDesktopLink(){
    const s=document.querySelector("#prephub-desktop-results #copyStatusDesktop");
    const temp=document.createElement("textarea");
    temp.value=PREPHUB_DESKTOP_LINK;
    temp.setAttribute("readonly","");
    temp.style.position="fixed";
    temp.style.left="-9999px";
    temp.style.top="-9999px";
    document.body.appendChild(temp);
    temp.focus();
    temp.select();

    try{
      const copied=document.execCommand("copy");
      if(s)s.textContent=copied?"Link copied to your clipboard.":"Press and hold the link to copy it.";
    }catch(e){
      if(s)s.textContent="Press and hold the link to copy it.";
    }

    document.body.removeChild(temp);
  }
})();
</script>
